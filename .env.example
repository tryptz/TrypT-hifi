# ---------------------------------------------------------------------------
# Qobuz (existing) — see README.md
# ---------------------------------------------------------------------------
QOBUZ_APP_ID=
QOBUZ_SECRET=
QOBUZ_API_BASE=https://www.qobuz.com/api.json/0.2/
QOBUZ_AUTH_TOKENS=[]

# Shared file-proxy signing secret (falls back to QOBUZ_SECRET if unset).
# Also used to sign Apple preview URLs and the Apple download-job manifest.
FILE_PROXY_SECRET=

# Optional outbound proxying (reused by both the Qobuz and Apple clients)
# CORS_PROXY=
# SOCKS5_PROXY=

# ---------------------------------------------------------------------------
# Apple Music (catalog + download-manifest layer)
#
# trypt-hifi authenticates to Apple with a MusicKit *developer token* (an ES256
# JWT). Provide EITHER a pre-baked token, OR the .p8 signing material below.
# ---------------------------------------------------------------------------

# Option A — pre-baked developer JWT (skips server-side signing entirely):
# APPLE_DEVELOPER_TOKEN=

# Option B — mint the developer token server-side (requires an Apple Developer
# Program membership with MusicKit enabled):
APPLE_TEAM_ID=            # 10-char Apple Developer Team ID (JWT `iss`)
APPLE_KEY_ID=            # 10-char MusicKit private-key Key ID (JWT header `kid`)
# The MusicKit .p8 (PKCS#8 PEM). Either paste it here (use \n for newlines on a
# single line) or point APPLE_PRIVATE_KEY_PATH at the file. Server-only; never
# shipped to the client.
APPLE_PRIVATE_KEY=
# APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# Optional
# APPLE_DEV_TOKEN_TTL_DAYS=150          # developer-token lifetime (max ~180 days)
# APPLE_MUSIC_USER_TOKEN=               # single-deployment Music-User-Token for /v1/me + lyrics
# APPLE_API_BASE=https://api.music.apple.com
# APPLE_STOREFRONT_DEFAULT=us

# ---------------------------------------------------------------------------
# Local Apple Music decryption wrapper (zhaarey/wrapper) — OPTIONAL, opt-in.
#
# Apple gates the hi-res / Atmos HLS master behind a real device, so the
# developer-token path above often can only flag `requiresWrapper.m3u8`. If you
# run the wrapper locally, set APPLE_WRAPPER_HOST and the manifest builder will
# resolve the *device* m3u8 via its get-m3u8 port (20020). Leave unset to keep
# the default web-only behaviour. Personal/research use only — the wrapper
# circumvents FairPlay DRM (see docs/apple-music-atmos-in-tryptify.md §9).
# APPLE_WRAPPER_HOST=127.0.0.1          # host of the running wrapper; unset = disabled
# APPLE_WRAPPER_M3U8_PORT=20020         # wrapper get-m3u8 TCP port
# APPLE_WRAPPER_DECRYPT_PORT=10020      # wrapper decrypt TCP port (used on-device, not server-side)
# APPLE_WRAPPER_TIMEOUT_MS=8000         # per-request TCP timeout
