# ---------------------------------------------------------------------------
# Tryptify (Qobuz browser downloader)
# ---------------------------------------------------------------------------

# Display name used throughout the Tryptify UI.
NEXT_PUBLIC_APPLICATION_NAME=Tryptify

# Host port for the Tryptify web UI.
TRYPTIFY_PORT=3000

# Optional: full URL for the header "Apple Music" button. Leave blank to point
# it at the current host on WEB_PORT (below). Set this when you front the Apple
# Music service with a reverse proxy, e.g. https://music.example.com
NEXT_PUBLIC_APPLE_MUSIC_URL=

# ---------------------------------------------------------------------------
# Apple Music service (ALACarte, ./apple-music submodule)
# ---------------------------------------------------------------------------

# Host path where downloaded music should end up (your main music library
# folder). REQUIRED — docker compose will refuse to start without this set.
MUSIC_PATH=/path/to/your/music/library

# Host port for the Apple Music web UI (also used by the Tryptify header button
# when NEXT_PUBLIC_APPLE_MUSIC_URL is empty).
WEB_PORT=7373

# Secret used to encrypt Apple credentials at rest (64 hex chars = 32 bytes).
# If not set, one is generated on first run and stored in ./data/web/.secret
AMDL_SECRET_KEY=

# Restrict the Apple Music UI to the host machine only. Leave blank to publish
# on all interfaces (default). Set to 127.0.0.1 if you front the app with a
# reverse proxy on the same host.
WEB_BIND=

# Disable the Apple Music service's built-in password gate. Only safe if you
# front it with your own auth (reverse proxy auth, VPN, mesh network, etc).
AUTH_DISABLED=false

# Trust proxy setting for the Apple Music service's Express server. Keep
# "loopback" for local reverse-proxy setups.
TRUST_PROXY=loopback

# Optional: override the Docker network name. Defaults to "trypt-net".
# DOCKER_NETWORK=trypt-net

# Optional: set to "true" to attach to an existing external network (e.g. one
# shared with Jellyfin/Plex). The network above must already exist.
# DOCKER_NETWORK_EXTERNAL=false
