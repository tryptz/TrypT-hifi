# ---- Qobuz-DL Discord bot configuration ----
# Copy relevant values into your project's root .env (which is gitignored).
# NEVER commit real tokens.

# Required: your bot's token from the Discord Developer Portal (Bot > Reset Token)
DISCORD_BOT_TOKEN=

# Required: your application's Client ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=

# Optional: register commands to a single guild for instant availability while
# developing. Leave empty to register commands globally.
DISCORD_GUILD_ID=

# Base URL of the running Qobuz-DL web app whose API the bot reuses.
APP_URL=http://localhost:3000

# Optional: country code forwarded as the Token-Country header (e.g. US, GB).
TOKEN_COUNTRY=

# Default download quality (Qobuz format id): 27=Hi-Res 24/192, 7=Hi-Res 24/96,
# 6=CD 16/44.1, 5=MP3 320.
BOT_DEFAULT_QUALITY=27

# Largest file (in MB) the bot will upload directly to Discord before falling
# back to a download link. Discord's default limit is 25.
BOT_MAX_UPLOAD_MB=25

# Optional: embed accent colour (hex, no leading #).
BOT_EMBED_COLOR=5865F2
